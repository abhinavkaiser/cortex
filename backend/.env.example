DATABASE_URL=sqlite:///./ai_academy.db

# Runs on your local Claude subscription via the `claude` CLI -- no API key
# needed. Only set these if `claude` isn't on PATH under its default name,
# or you want a different default model.
# CLAUDE_BIN=claude
# CLAUDE_MODEL=claude-sonnet-4-6

JWT_SECRET=change-me-to-a-real-random-secret
